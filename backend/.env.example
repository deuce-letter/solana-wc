# ==========================================
# Reown / WalletConnect (Required)
# ==========================================
# Get your Project ID from https://reown.com
REOWN_PROJECT_ID=

# ==========================================
# Solana Wallet Settings (Optional)
# ==========================================
# Base58 encoded keypair (64 bytes) or seed (32 bytes)
# Leave empty to fallback to ~/.config/solana/id.json
# e.g. 11111111111111111111111111111111
SOLANA_PRIVATE_KEY=

# Expected Solana wallet address for safety verification on startup
# e.g. 4zvwRjXUKGfvwnParsHAS3HuSVzV5cA4McphgmoCtajS
SOLANA_PUBLIC_KEY=

# ==========================================
# Server & CORS Settings (Optional)
# ==========================================
# Port for the local Socket.IO server (default: 3001)
SOCKET_PORT=3001

# Additional frontend origin allowed by CORS
# (localhost:5173 and 127.0.0.1:5173 are allowed by default)
# e.g. http://localhost:4173
FRONTEND_ORIGIN=

# ==========================================
# Logger Settings (Optional)
# ==========================================
# silent | fatal | error | warn | info (default) | debug | trace
# quiet <---> canary
LOG_LEVEL=info